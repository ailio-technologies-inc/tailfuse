{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tailfuse",
  "version": "0.1.31",
  "identifier": "com.ailio.tailfuse",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "npm run stage:tailscale",
    "beforeBuildCommand": "npm run stage:tailscale"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tailfuse",
        "width": 720,
        "height": 560,
        "minWidth": 560,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "label": "panel",
        "width": 340,
        "height": 400,
        "minWidth": 340,
        "minHeight": 280,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "shadow": false,
        "title": "Tailfuse"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/tailscale",
      "binaries/tailscaled"
    ],
    "resources": [
      "binaries/tailscale-LICENSE.txt"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application: Luigi Poole (N7TM93NL4Q)",
      "hardenedRuntime": true
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFEOENFOTU4NkVEMDc0NEYKUldSUGROQnVXT21NSFNjUFZrQXVDSUJTOEFuUzVCR05BbHhWWXdMcElVelhKeXBXQXEwdVBlVVcK",
      "endpoints": [
        "https://tailfuse.com/update/latest.json",
        "https://github.com/ailio-technologies-inc/tailfuse/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
