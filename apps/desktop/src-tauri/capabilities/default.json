{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the Tailfuse windows: the main window and its dialogs in windows of their own (open_sheet)",
  "windows": [
    "main",
    "options-*",
    "phone"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "opener:default",
    "notification:default",
    "dialog:default",
    "core:window:allow-close"
  ]
}
